# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values.
#
# SUPABASE KEY MODEL (new API keys, not the legacy anon/service_role JWTs):
#   sb_publishable_*  -> safe in the browser. May carry a NEXT_PUBLIC_ prefix.
#   sb_secret_*       -> SERVER ONLY. Must NEVER carry a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Supabase — public (inlined into the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase — SERVER ONLY. Bypasses RLS. Must never reach the browser.
SUPABASE_SECRET_KEY=""

# PostgreSQL / Drizzle — SERVER ONLY.
# Local dev and migrations: the Supabase SESSION pooler (port 5432).
# Vercel (serverless): the TRANSACTION pooler (port 6543) is recommended by
# Supabase for short-lived functions; every setting `withUser()` makes is
# transaction-local (set_config(..., true)), and node-postgres sends unnamed
# statements, so the whole DB suite passes on 6543 (VERCEL_DEPLOY_AUDIT.md §DB).
# Run `pnpm db:migrate` with the session URL, never from the Vercel build.
DATABASE_URL=""

# Internal crypto — SERVER ONLY. Generate once per environment and keep it
# STABLE across deploys: changing ENCRYPTION_KEY makes every stored payment
# credential and webhook secret undecryptable (connections must be redone).
# 32 random bytes, base64 encoded:  openssl rand -base64 32
ENCRYPTION_KEY=""
# Pepper for one-way hashes (API keys, e-mails, IPs). Same rule: changing it
# invalidates every existing API key and e-mail hash.  openssl rand -base64 32
HASH_PEPPER=""

# Stripe — SERVER ONLY (optional until you connect billing)
STRIPE_SECRET_KEY=""
# Legacy platform endpoint only (/api/webhooks/stripe: Connect, `stripe listen`).
# Workspaces paste their own endpoint's signing secret under Integrations; it is
# stored encrypted per integration, not here.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# Billing connectors in beta (Mercado Pago, AbacatePay, Asaas) are offered in the
# product with a "Beta" label. List any to turn into "Coming soon" (not
# connectable, webhook route 404). Stripe cannot be disabled here.
BILLING_CONNECTORS_DISABLED=""

# Platform billing — SERVER ONLY. Refvia's OWN Stripe account, charging
# workspaces for Launch/Growth (docs/PLANS.md §5). Not the founders' Stripe
# above. Optional as a set: leave all four empty and Settings offers the manual
# plan request instead of Checkout.
# Secret key of Refvia's Stripe account (sk_test_… / sk_live_…).
PLATFORM_STRIPE_SECRET_KEY=""
# Signing secret of the endpoint <APP_URL>/api/platform-billing/stripe/webhook.
PLATFORM_STRIPE_WEBHOOK_SECRET=""
# Recurring monthly BRL Prices; keep equal to PLAN_OFFERS in src/lib/plans.ts.
STRIPE_LAUNCH_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""

# App
# Where the product runs: dashboard, /api/*, /t.js, OAuth and e-mail redirects,
# and the base of every webhook URL shown to founders. REQUIRED in production
# (e.g. https://refvia.com.br). Never a *.vercel.app preview URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public website (SEO_DEPLOY_CHECKLIST.md)
# Origin of canonical URLs, hreflang, the sitemap and Open Graph. Empty = same
# as NEXT_PUBLIC_APP_URL. Site and app on one host: https://refvia.com.br for both.
NEXT_PUBLIC_SITE_URL=""
# "on" lets search engines index the site (robots.txt allows crawling, the
# sitemap is published, public pages carry `index`). Anything else keeps every
# page noindex and robots.txt closed — leave it off on temporary hosts and
# previews. Read at build time: rebuild after changing it. Even when "on", a
# Vercel Preview/Development deployment and a *.vercel.app or localhost site
# URL stay noindex (src/lib/seo/metadata.ts).
SITE_INDEXING=""
