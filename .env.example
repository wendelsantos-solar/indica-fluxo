# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values.
#
# SUPABASE KEY MODEL (new API keys, not the legacy anon/service_role JWTs):
#   sb_publishable_*  -> safe in the browser. May carry a NEXT_PUBLIC_ prefix.
#   sb_secret_*       -> SERVER ONLY. Must NEVER carry a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Supabase — public (inlined into the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase — SERVER ONLY. Bypasses RLS. Must never reach the browser.
SUPABASE_SECRET_KEY=""

# PostgreSQL / Drizzle — SERVER ONLY.
# Use the SESSION pooler (port 5432) rather than the transaction pooler:
# `withUser()` relies on SET LOCAL inside a transaction.
DATABASE_URL=""

# Internal crypto — SERVER ONLY.
# 32 random bytes, base64 encoded:  openssl rand -base64 32
ENCRYPTION_KEY=""
# Pepper for one-way hashes (API keys, e-mails, IPs). Changing it invalidates
# every existing API key and e-mail hash.
HASH_PEPPER=""

# Stripe — SERVER ONLY (optional until you connect billing)
STRIPE_SECRET_KEY=""
# Legacy platform endpoint only (/api/webhooks/stripe: Connect, `stripe listen`).
# Workspaces paste their own endpoint's signing secret under Integrations; it is
# stored encrypted per integration, not here.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
